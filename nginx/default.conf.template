# Шаблон: ${DOMAIN} подставляется из окружения контейнера nginx при старте.

server {
    listen 80;
    server_name ${DOMAIN};

    # Проверка домена Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 12m;   # лимит загрузки файлов чуть выше лимита приложения

    root /usr/share/nginx/html;

    # Статика Django (админка, drf-spectacular)
    location /static/ {
        alias /staticfiles/;
    }

    # API и админка Django
    location ~ ^/(api|admin)/ {
        proxy_pass http://django:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # не доверяем чужому заголовку
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Файлы фронтенда с хэшем в имени — кэшируем надолго
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Service worker не кэшируем, иначе обновления не доедут до пользователей
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # SPA: любые остальные пути отдают index.html
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
