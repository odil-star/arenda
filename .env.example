# Переменные docker compose (файл .env в корне репозитория, рядом с docker-compose.yml).
# Секреты Django, платежей и бота — отдельно, в backend/.env (см. backend/.env.example).
# Сгенерировать пароли: ./scripts/gen-secrets.sh

# Домен, на который смотрит DNS-запись сервера (без https://)
DOMAIN=rent.example.com
# Почта для уведомлений Let's Encrypt
LETSENCRYPT_EMAIL=you@example.com

POSTGRES_DB=rent
POSTGRES_USER=rent
# Обязателен. Только буквы и цифры (пароль попадает в DATABASE_URL)
POSTGRES_PASSWORD=
