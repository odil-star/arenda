# Скопируйте в .env (для Docker: backend/.env). Секреты — только здесь/в окружении, не в коде.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod   # локально: config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string  # обязателен в prod (>= 32 символов)
ALLOWED_HOSTS=localhost,127.0.0.1             # обязателен в prod
DEBUG=False                                   # учитывается только в dev; в prod всегда False
CORS_ORIGINS=http://localhost:5173            # через запятую
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False                     # в проде за HTTPS оставьте True (по умолчанию)
NUM_PROXIES=1                                 # число обратных прокси (nginx) для троттлинга по IP
AUTH_THROTTLE_RATE=10/min
API_DOCS_ENABLED=False                        # /api/docs/ и /api/schema/ (в dev включены)

# --- Кабинет жильца ---
FRONTEND_URL=http://localhost:5173            # база ссылок-приглашений: <FRONTEND_URL>/join/<token>
SMS_BACKEND=console                           # console (код в лог, dev) | eskiz | locmem (тесты)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Почта (сброс пароля); по умолчанию письма идут в консоль ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# --- База данных и очередь ---
DATABASE_URL=postgres://rent:rent@db:5432/rent
POSTGRES_DB=rent
POSTGRES_USER=rent
POSTGRES_PASSWORD=rent
REDIS_URL=redis://redis:6379/0
CELERY_EAGER=False

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Платежи ---
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz     # тест: https://test.paycom.uz
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Файлы: S3-совместимое хранилище (R2/MinIO). Пусто — локальный диск ---
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# --- Web Push: python manage.py generate_vapid ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=INFO
